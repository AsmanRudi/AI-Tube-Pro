# Gemini AI API Key (default fallback, opsional - key per-user dikirim dari backend via header X-API-Key)
# GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini Model (optional, defaults to gemini-2.5-flash)
# Model yang tersedia: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash, gemini-2.0-flash-lite
GEMINI_MODEL="gemini-2.5-flash"